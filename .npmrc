# react-scripts@5 peer-requires typescript ^3 || ^4, but this project
# runs typescript ^5 (which builds fine with CRA). npm 7+ treats the
# peer mismatch as a hard ERESOLVE error on a clean install — which is
# what Vercel does. legacy-peer-deps makes the install tolerant of the
# mismatch, matching how it already resolves locally. Remove only if
# react-scripts is replaced or upgraded to a TS5-compatible peer range.
legacy-peer-deps=true
