# amber-esol-mvp — environment variables
# Copy to .env and fill in. Create-React-App only reads vars prefixed with
# REACT_APP_. Restart `npm start` after changing this file.

# Backend API root. Must include /api suffix because axios calls hit
# `/users/login`, `/bookings`, etc. (not `/api/users/login`).
REACT_APP_BACKEND_URL=http://localhost:4000/api

# Used by SignupChoice and the hero CTA to construct absolute links back
# into the dashboard from public-marketing pages.
REACT_APP_DASHBOARD_URL=http://localhost:3000
REACT_APP_FRONTEND_URL=http://localhost:3000
