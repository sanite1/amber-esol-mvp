# amber-esol-mvp — environment variables
# Copy to .env and fill in. Create-React-App only reads vars prefixed with
# REACT_APP_. Restart `npm start` after changing this file.

# Backend API root. Must include /api suffix because axios calls hit
# `/users/login`, `/bookings`, etc. (not `/api/users/login`).
REACT_APP_BACKEND_URL=http://localhost:4000/api

# Used by SignupChoice and the hero CTA to construct absolute links back
# into the dashboard from public-marketing pages. Same host in single-
# host deployment — kept for legacy callsites that still read it.
REACT_APP_DASHBOARD_URL=http://localhost:3000
REACT_APP_FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────
# Routing model (M0.3) — path-prefix, single host
# ─────────────────────────────────────────────────────────────────────
# The whole platform lives at one URL. Audience-shells (learner /
# teacher / admin / marketing) are derived from the URL path prefix:
#
#   /                       → marketing landing
#   /about, /help, /...     → public pages
#   /roi-calculator         → public ROI calc
#   /login, /signup, /...   → auth pages
#
#   /learner/*              → learner shell
#   /esol/*                 → learner alias (legacy)
#   /teacher/*              → teacher portal
#   /tutor/*                → teacher alias (legacy marketplace)
#   /admin/*                → admin shell (org admin + Amber super-admin,
#                             role-gated inside)
#   /org/* and /org-admin/* → admin alias (org admin paths)
#
# Production host:  esol.ambertraining.co.uk
# Local dev host:   localhost:3000
#
# No subdomains, no /etc/hosts, no `?shell=` overrides — same URLs work
# in dev and prod. The apex `ambertraining.co.uk` is reserved for Amber's
# firstaid product line and is never served by this build.

# ─────────────────────────────────────────────────────────────────────
# Cookie scope (M0.4)
# ─────────────────────────────────────────────────────────────────────
# Single-host deployment means cookies are host-scoped by default —
# perfect for our case (all shells share the same origin). Leave this
# unset everywhere. Only set it for unusual staging setups where a
# reverse proxy serves two hosts that need to share a session.
REACT_APP_COOKIE_DOMAIN=
